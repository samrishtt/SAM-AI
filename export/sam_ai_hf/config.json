{
  "architectures": [
    "SAMForCausalLM"
  ],
  "attention_type": "mla",
  "auto_map": {
    "AutoConfig": "configuration_sam.SAMConfig",
    "AutoModel": "modeling_sam.SAMModel",
    "AutoModelForCausalLM": "modeling_sam.SAMForCausalLM"
  },
  "d_ff": 1408,
  "d_latent_kv": 128,
