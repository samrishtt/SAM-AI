  "n_heads": 8,
  "n_kv_heads": 2,
  "n_layers": 6,
  "n_routed_experts": 8,
  "n_shared_experts": 1,
  "rms_norm_eps": 1e-06,
  "tie_word_embeddings": false,
  "top_k_experts": 2,
  "transformers_version": "5.17.0",
  "use_aux_free_lb": true,
  "use_moe": false,
  "use_mtp": true,
  "vocab_size": 32000,
  "window_size": 512
