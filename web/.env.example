# ==============================================================================
# SAM-AI Web Chat MVP — Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# On Vercel, configure these in Project Settings -> Environment Variables.
# NEVER commit .env.local or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Provider Selection (Default: qwen_openai_compatible)
# Options:
#   - qwen_openai_compatible: Connects to a dedicated inference server (vLLM, SGLang, Ollama)
#   - google: Optional fallback connecting to Google Gemini API
# ------------------------------------------------------------------------------
SAM_AI_PROVIDER=qwen_openai_compatible

# ------------------------------------------------------------------------------
# Qwen Inference Endpoint Configuration (Required when SAM_AI_PROVIDER=qwen_openai_compatible)
# ------------------------------------------------------------------------------
# The primary research model identifier:
SAM_AI_MODEL=Qwen/Qwen3.8-27B

# The HTTP URL of your vLLM, SGLang, or OpenAI-compatible server endpoint:
# Examples:
#   - Hosted Hugging Face Inference Providers router: https://router.huggingface.co/v1
#   - Local vLLM: http://localhost:8000/v1
#   - Local Ollama: http://localhost:11434/v1
#   - Together AI: https://api.together.xyz/v1
SAM_AI_BASE_URL=

# Server-side API key for the inference endpoint:
# - For Hugging Face router: your Hugging Face User Access Token (hf_...)
# - For local vLLM / Ollama: leave empty or set to "EMPTY"
SAM_AI_API_KEY=

# ------------------------------------------------------------------------------
# Optional Google Provider Configuration (Only used when SAM_AI_PROVIDER=google)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Optional: Server-Side Access Gate Password
# If set, users must enter this password to unlock the UI and execute API requests.
# If left empty, the application operates in open preview mode.
SAM_AI_SITE_PASSWORD=

# ------------------------------------------------------------------------------
# Generation & Rate Limiting Controls
# ------------------------------------------------------------------------------
SAM_AI_MAX_OUTPUT_TOKENS=2048
SAM_AI_TEMPERATURE=0.7
SAM_AI_RATE_LIMIT_PER_MINUTE=20

