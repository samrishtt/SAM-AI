# ==============================================================================
# SAM-AI Web Chat & Code MVP — Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# On production, configure these in your secure server environment.
# NEVER commit .env.local, passwords, or secret tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Authoritative Model Identity & Adapter Configuration
# ------------------------------------------------------------------------------
# Default model matching the verified SAM-AI learning experiment:
SAM_AI_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# Optional path to a trained and verified LoRA adapter (leave empty for pure foundation model):
# Note: Experiment 001 adapter is rejected; leave unconfigured to use pure base model.
# SAM_AI_ADAPTER_PATH=

# ------------------------------------------------------------------------------
# Sovereign Inference Server Endpoint (Local / Owner-Controlled Only)
# ------------------------------------------------------------------------------
# SAM-AI strictly forbids third-party commercial inference routers (Hugging Face router,
# OpenRouter, Together AI, Google Gemini, OpenAI API, etc.).
# Point this to your self-hosted or project-controlled inference server or Space:
#   - Local SAM-AI Server:             http://127.0.0.1:8000/v1
#   - Local vLLM / SGLang:             http://127.0.0.1:8000/v1
#   - Dedicated Gradio ZeroGPU Space:  https://<your-username>-<space-name>.hf.space
#     (Note: When using a remote Space, also add its domain to SAM_AI_TRUSTED_HOSTS)
SAM_AI_BASE_URL=http://127.0.0.1:8000/v1

# Optional API Key for authenticating to your own private server:
# (Leave empty or "EMPTY" if your local server does not require authorization)
SAM_AI_API_KEY=

# ------------------------------------------------------------------------------
# SAM-AI Code Workspace Configuration (Local Read-Only)
# ------------------------------------------------------------------------------
# Explicit filesystem path for the local read-only repository workspace.
# If unset, defaults to the current repository directory.
# All operations are strictly read-only; path traversal and secret files are excluded.
SAM_AI_WORKSPACE_ROOT=

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Optional: Site access gate password
# If set, users must enter this password to unlock the UI and execute requests.
# If left empty, operates in open local preview mode.
SAM_AI_SITE_PASSWORD=

# Explicit trusted remote hostnames (comma-separated).
# Loopback addresses (localhost, 127.0.0.1) are always allowed.
# Remote HTTPS endpoints are only permitted if explicitly added here:
SAM_AI_TRUSTED_HOSTS=

# Whether to trust x-forwarded-for and x-real-ip proxy headers for rate limiting.
# Set to 'true' only if behind an authentic, owner-controlled reverse proxy (e.g. Caddy, NGINX).
SAM_AI_TRUST_PROXY=false

# ------------------------------------------------------------------------------
# Generation & Rate Limiting Controls
# ------------------------------------------------------------------------------
SAM_AI_MAX_OUTPUT_TOKENS=2048
SAM_AI_TEMPERATURE=0.7
SAM_AI_RATE_LIMIT_PER_MINUTE=20
